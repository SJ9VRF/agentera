---
const { title = "Agentera", description = "Virtual AI Company & Applied Agents" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>body{font-family:Inter,system-ui,Arial,sans-serif}</style>
  </head>
  <body>
    <link rel="stylesheet" href="/agentera/styles/global.css" />
    <header class="container py-6 flex items-center justify-between">
      <a href="/" class="no-underline">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-white/10 grid place-items-center border border-white/15">⚙️</div>
          <span class="text-xl font-bold tracking-wide">Agentera</span>
        </div>
      </a>
      <nav class="flex gap-6">
        <a href="/products/ai_virtual_company">AI Virtual Company</a>
        <a href="/products/ai_for_law_firms">AI for Law Firms</a>
        <a href="/products/ai_information_verifier">CertiFy</a>
        <a href="/docs">Docs</a>
        <a href="https://github.com/sj9vrf/agentera" target="_blank">GitHub</a>
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="container py-10 mt-16 small">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <span>© {new Date().getFullYear()} Agentera. All rights reserved.</span>
        <span>Built with Astro + Tailwind on GitHub Pages.</span>
      </div>
    </footer>
  </body>
</html>