---
import Base from "../layouts/Base.astro";

const links = {
  github: "https://github.com/sj9vrf/agentera",
  vc: "/products/ai_virtual_company",
  law: "/products/ai_for_law_firms",
  verify: "/products/ai_information_verifier",
  docs: "/docs",
};
---

<Base title="Agentera — Agentic AI" description="Agentera: AI Virtual Company, AI for Law Firms, and CertiFy Information Verifier.">

  <!-- HERO -->
  <section class="hero mt-2">
    <div class="max-w-3xl">
      <h1 class="h1 leading-tight">
        Agentic AI that <span class="grad-text">plans, verifies, ships</span>.
      </h1>
      <p class="mt-3 lead">
        Three focused products: <b>AI Virtual Company</b>, <b>AI for Law Firms</b>, and <b>CertiFy</b> —
        an API-first information verifier with citations and confidence scores.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={links.vc} class="btn">Explore Products</a>
        <a href={links.docs} class="btn">Documentation</a>
        <a href={links.github} class="btn" target="_blank">GitHub</a>
      </div>
    </div>
  </section>

  <!-- THREE PRODUCT CARDS -->
  <section class="grid md:grid-cols-3 gap-6 mt-10">
    <!-- AI Virtual Company -->
    <a href={links.vc} class="card no-underline block">
      <div class="flex items-start gap-3">
        <!-- Organization icon -->
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M3 21h18M6 21V7h12v14M9 7V3h6v4" />
          <path d="M9 12h6M9 16h6" />
        </svg>
        <div>
          <h2 class="h2 mb-1">AI Virtual Company</h2>
          <p class="text-text-soft text-sm">Simulate roles, workflows, and KPIs with autonomous agents.</p>
        </div>
      </div>
    </a>

    <!-- AI for Law Firms -->
    <a href={links.law} class="card no-underline block">
      <div class="flex items-start gap-3">
        <!-- Law scales icon -->
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M12 3v3M5 21h14M12 6l-6 6h12l-6-6zM6 12c0 3-2 5-2 5h4s-2-2-2-5zm12 0c0 3-2 5-2 5h4s-2-2-2-5z"/>
        </svg>
        <div>
          <h2 class="h2 mb-1">AI for Law Firms</h2>
          <p class="text-text-soft text-sm">Discovery, precedent retrieval, and drafting with audit-ready reasoning.</p>
        </div>
      </div>
    </a>

    <!-- CertiFy -->
    <a href={links.verify} class="card no-underline block">
      <div class="flex items-start gap-3">
        <!-- Shield check icon -->
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M12 3l7 4v5c0 5-3.5 9-7 9s-7-4-7-9V7l7-4z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
        <div>
          <h2 class="h2 mb-1">CertiFy — Verifier</h2>
          <p class="text-text-soft text-sm">API-first fact verification with confidence scoring and citations.</p>
        </div>
      </div>
    </a>
  </section>

  <!-- WHY / HOW -->
  <section class="grid md:grid-cols-2 gap-6 mt-10">
    <div class="card">
      <h3 class="h2 mb-2">Why Now</h3>
      <ul class="text-sm text-text-soft space-y-2">
        <li>Enterprises are moving from demos to outcomes.</li>
        <li>Coordination, verification, and governance are required.</li>
        <li>SOC2-ready patterns, audit logs, and approver gates.</li>
      </ul>
    </div>
    <div class="card">
      <h3 class="h2 mb-2">How It Works</h3>
      <ol class="text-sm text-text-soft space-y-2 list-decimal list-inside">
        <li>Connect data sources (Docs/GitHub/DMS/Web).</li>
        <li>Orchestrate role-based agents with memory & tools.</li>
        <li>Verify outputs via CertiFy before shipping.</li>
        <li>Ship with dashboards, exports, and approvals.</li>
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="mt-10 rounded-3xl border border-white/10 p-8 bg-white/[0.04] text-center shadow-soft">
    <h3 class="h2">Seeking 2–3 Pilot Partners</h3>
    <p class="mt-2 text-text-soft">Legal Ops, enterprise R&D, and platforms needing verification.</p>
    <div class="mt-4 flex justify-center gap-3">
      <a class="btn" href={links.docs}>Documentation</a>
      <a class="btn" href={links.github} target="_blank">GitHub</a>
    </div>
  </section>

</Base>
