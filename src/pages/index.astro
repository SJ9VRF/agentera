---
import Base from "../layouts/Base.astro";
---
<Base title="Agentera — Virtual AI Company" description="Three products: AI Virtual Company, AI for Law Firms, and CertiFy information verifier.">
  <section class="py-16">
    <h1 class="h1">Agentera</h1>
    <p class="mt-4 text-lg text-gray-200 max-w-3xl">
      A suite of agentic AI products: simulate entire organizations, accelerate legal workflows, and verify information at scale.
    </p>

    <div class="grid md:grid-cols-3 gap-6 mt-10">
      <a class="card no-underline" href="/products/ai_virtual_company">
        <h2 class="h2 mb-2">AI Virtual Company</h2>
        <p>Create a living simulation of a full company: CEO, engineers, analysts, PMs — all autonomous agents coordinating on goals.</p>
      </a>
      <a class="card no-underline" href="/products/ai_for_law_firms">
        <h2 class="h2 mb-2">AI for Law Firms</h2>
        <p>Discovery, drafting, precedent search, and evidence triage with verifiable chains-of-thought and audit trails.</p>
      </a>
      <a class="card no-underline" href="/products/ai_information_verifier">
        <h2 class="h2 mb-2">CertiFy — Information Verifier</h2>
        <p>Multi-agent fact-checking with source attribution, confidence scoring, and enterprise policy hooks.</p>
      </a>
    </div>
  </section>
</Base>