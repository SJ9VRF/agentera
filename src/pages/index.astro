---
import Base from "../layouts/Base.astro";

const links = {
  github: "https://github.com/sj9vrf/agentera",
  vc: "/products/ai_virtual_company",
  law: "/products/ai_for_law_firms",
  verify: "/products/ai_information_verifier",
  docs: "/docs",
};
---

<Base title="Agentera — Agentic AI" description="Agentera: AI Virtual Company, AI for Law Firms, and CertiFy Information Verifier.">

  <!-- HERO -->
  <section class="hero mt-2">
    <div class="max-w-3xl">
      <h1 class="h1 leading-tight">
        Agentic AI that <span class="grad-text">plans, verifies, and ships</span>.
      </h1>
      <p class="mt-3 lead">
        Agentera builds enterprise-grade agentic systems. Our suite includes:  
        <b>AI Virtual Company</b>, <b>AI for Law Firms</b>, and <b>CertiFy</b> —  
        tools that simulate organizations, accelerate legal workflows, and verify information.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#products" class="btn">Explore Products</a>
        <a href={links.docs} class="btn">Documentation</a>
        <a href={links.github} class="btn" target="_blank">GitHub</a>
      </div>
    </div>
  </section>

  <!-- PRODUCTS OVERVIEW -->
  <section id="products" class="mt-12 space-y-12">

    <!-- Virtual Company -->
    <div class="card">
      <div class="flex items-start gap-4">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0">
          <path d="M3 21h18M6 21V7h12v14M9 7V3h6v4" />
          <path d="M9 12h6M9 16h6" />
        </svg>
        <div>
          <h2 class="h2">AI Virtual Company</h2>
          <p class="mt-2 text-text-soft">
            A living simulation of an organization. Agents represent CEO, PM, Engineering, and Legal — coordinating, planning, and cross-reviewing outputs with governance built-in.
          </p>
          <ul class="mt-3 text-sm list-disc list-inside space-y-1 text-text-soft">
            <li>Org Graph: map dependencies, KPIs, and ownership</li>
            <li>Scenario Planning: hiring, budget, roadmap changes</li>
            <li>Governance: audit logs, checkpoints, and approvals</li>
          </ul>
          <a href={links.vc} class="btn mt-4">Learn More</a>
        </div>
      </div>
    </div>

    <!-- Law Firms -->
    <div class="card">
      <div class="flex items-start gap-4">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0">
          <path d="M12 3v3M5 21h14M12 6l-6 6h12l-6-6zM6 12c0 3-2 5-2 5h4s-2-2-2-5zm12 0c0 3-2 5-2 5h4s-2-2-2-5z"/>
        </svg>
        <div>
          <h2 class="h2">AI for Law Firms</h2>
          <p class="mt-2 text-text-soft">
            Accelerate discovery, precedent retrieval, and drafting. Every output includes citations, reasoning, and audit trails to ensure trust and compliance.
          </p>
          <ul class="mt-3 text-sm list-disc list-inside space-y-1 text-text-soft">
            <li>E-Discovery triage and clustering</li>
            <li>Precedent retrieval with jurisdiction filters</li>
            <li>Drafting with citations and rationale surfaced</li>
          </ul>
          <a href={links.law} class="btn mt-4">Learn More</a>
        </div>
      </div>
    </div>

    <!-- CertiFy -->
    <div class="card">
      <div class="flex items-start gap-4">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0">
          <path d="M12 3l7 4v5c0 5-3.5 9-7 9s-7-4-7-9V7l7-4z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
        <div>
          <h2 class="h2">CertiFy — Information Verifier</h2>
          <p class="mt-2 text-text-soft">
            API-first fact verification. Submit a claim → get a veracity score, linked evidence, and rationale.  
            Ensure only trustworthy content reaches your users.
          </p>
          <ul class="mt-3 text-sm list-disc list-inside space-y-1 text-text-soft">
            <li>Analyst, Skeptic, Judge multi-agent pipeline</li>
            <li>Evidence-linked citations & confidence scoring</li>
            <li>Policy-aware: domain allow/deny, recency, authority</li>
          </ul>
          <a href={links.verify} class="btn mt-4">Learn More</a>
        </div>
      </div>
    </div>

  </section>

  <!-- WHY / HOW -->
  <section class="grid md:grid-cols-2 gap-6 mt-14">
    <div class="card">
      <h3 class="h2 mb-2">Why Now</h3>
      <ul class="text-sm text-text-soft space-y-2">
        <li>AI adoption is moving from demos to business-critical outcomes.</li>
        <li>Organizations demand governance, auditability, and verification.</li>
        <li>Agentera delivers SOC2-ready patterns and human-in-the-loop controls.</li>
      </ul>
    </div>
    <div class="card">
      <h3 class="h2 mb-2">How It Works</h3>
      <ol class="text-sm text-text-soft space-y-2 list-decimal list-inside">
        <li>Connect data sources (Docs, GitHub, DMS, Web).</li>
        <li>Orchestrate role-based agents with memory & tools.</li>
        <li>Verify outputs via CertiFy before shipping.</li>
        <li>Ship with dashboards, exports, and approvals.</li>
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="mt-12 rounded-3xl border border-white/10 p-10 bg-white/[0.04] text-center shadow-soft">
    <h3 class="h2">Seeking 2–3 Pilot Partners</h3>
    <p class="mt-2 text-text-soft">
      Legal Ops, enterprise R&D teams, and platforms that need trustworthy, verifiable AI.
    </p>
    <div class="mt-4 flex justify-center gap-3">
      <a class="btn" href={links.docs}>Documentation</a>
      <a class="btn" href={links.github} target="_blank">GitHub</a>
    </div>
  </section>

</Base>
